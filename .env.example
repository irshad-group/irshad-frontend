# ============================================
# Irshad Frontend — Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.
#
# NOTE: This file configures the *application*. Claude Code's own access to
# PocketBase is configured separately in .mcp.json — the two are independent
# and both need the PocketBase URL.

# PocketBase base URL. No trailing slash.
# Inlined into the client bundle, so this value is public by definition.
# Example: https://pb.irshad.example.com
NEXT_PUBLIC_PB_URL=

# PocketBase superuser credentials — SERVER ONLY.
# Used for schema migrations, seeding, and admin-only server tasks.
# Never prefix these with NEXT_PUBLIC_, never import them into a Client
# Component, and never use them to serve ordinary user requests: end users
# authenticate as themselves and PocketBase API rules do the authorization.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
